{
  "name": "@visionset/ui-core",
  "version": "0.0.1-beta.4",
  "description": "VisionSet domain components, design tokens, and the generated typed API contract with the data port a host implements. UI primitives: Radix behaviour under shadcn Nova styling, with lucide icons.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robomous/VisionSet.git",
    "directory": "frontend/ui-core"
  },
  "homepage": "https://github.com/Robomous/VisionSet#readme",
  "bugs": {
    "url": "https://github.com/Robomous/VisionSet/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src && pnpm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@robomous/ui-core": "^0.5.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@visionset/annotator": "workspace:*",
    "@visionset/media": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.52.0",
    "openapi-fetch": "^0.17.0",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  }

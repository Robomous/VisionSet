{
  "name": "@visionset/app",
  "version": "0.0.1-beta.2",
  "description": "VisionSet OSS product shell. Private — never published to npm; the compiled bundle ships inside the Python wheel.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src e2e cycle bench playwright.config.ts playwright.bench.config.ts playwright.cycle.config.ts && pnpm run typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "bench": "playwright test -c playwright.bench.config.ts",
    "e2e:report": "playwright show-report",
    "cycle": "playwright test -c playwright.cycle.config.ts"
  },
  "dependencies": {
    "@visionset/annotator": "workspace:*",
    "@visionset/ui-core": "workspace:*",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^7.0.0"
  }
}

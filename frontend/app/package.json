{
  "name": "@visionset/app",
  "version": "0.0.1-beta.4",
  "description": "VisionSet OSS product shell. Private — never published to npm; the compiled bundle ships inside the Python wheel.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint src e2e cycle bench e2e-ports.ts playwright.config.ts playwright.bench.config.ts playwright.cycle.config.ts && pnpm run typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "bench": "playwright test -c playwright.bench.config.ts",
    "e2e:report": "playwright show-report",
    "cycle": "playwright test -c playwright.cycle.config.ts"
  },
  "dependencies": {
    "@robomous/ui-core": "^0.2.1",
    "@visionset/annotator": "workspace:*",
    "@visionset/media": "workspace:*",
    "@visionset/ui-core": "workspace:*",
    "lucide-react": "^1.44.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}

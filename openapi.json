    "/projects/{project_id}": {
      "delete": {
        "description": "Remove a project and everything under it.\n\nMetadata only: content blobs are shared and are never deleted. Without\n`confirm=true` this answers 409 `CONFIRMATION_REQUIRED` and destroys nothing.",
        "operationId": "delete_project",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Project Id",
              "type": "string"
            }
          },
          {
            "description": "Required to destroy data. The kernel refuses the request without it.",
            "in": "query",
            "name": "confirm",
            "required": false,
            "schema": {
              "default": false,
              "description": "Required to destroy data. The kernel refuses the request without it.",
              "title": "Confirm",
              "type": "boolean"
            }
